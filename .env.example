# Clave de API de Google Gemini (Obtenla en https://aistudio.google.com/)
GEMINI_API_KEY=

# Modelo de Gemini a utilizar (gemini-2.5-flash ya no está disponible para cuentas nuevas)
GEMINI_MODEL=gemini-3.5-flash

# Modelos de respaldo, en orden, si el principal está saturado (503), sin cuota (429) o no responde
GEMINI_MODELOS_RESPALDO=gemini-flash-lite-latest,gemini-3.8-flash

# Puerto del servidor backend (Opcional, por defecto 8000)
PORT=8000
